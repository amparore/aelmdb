+static int
+mdb_dbi_check_tree_layout(MDB_txn *txn, const MDB_db *db)
+{
+	MDB_cursor mc;
+	MDB_xcursor mx;
+	MDB_page *rootp;
+	int rc;
+
+	if (db->md_depth == 0)
+		return db->md_root == P_INVALID ? MDB_SUCCESS : MDB_CORRUPTED;
+	if (db->md_root == P_INVALID || (pgno_t)db->md_root >= txn->mt_next_pgno)
+		return MDB_CORRUPTED;
+
+	/* The helper only needs a transaction-backed cursor for page_get(), but
+	 * mdb_cursor_init() requires an xcursor whenever MAIN_DBI itself is
+	 * DUPSORT (a non-empty DUPSORT main DB failed validation on reopen). */
+	mdb_cursor_init(&mc, txn, MAIN_DBI,
+		(txn->mt_dbs[MAIN_DBI].md_flags & MDB_DUPSORT) ? &mx : NULL);
+	mc.mc_db = (MDB_db *)db;
+	rc = mdb_page_get(&mc, db->md_root, &rootp, NULL);
+	if (rc)
+		return rc;
+	if (db->md_depth == 1) {
+		if (!IS_LEAF(rootp))
+			return MDB_CORRUPTED;
+	} else if (!IS_BRANCH(rootp)) {
+		return MDB_CORRUPTED;
+	}
+	if (PAGE_AGGFLAGS(rootp) != (IS_BRANCH(rootp) ? DB_AGGFLAGS(db) : 0))
+		return MDB_CORRUPTED;
+	return MDB_SUCCESS;
+}
