+ */
+
+/** Frames of #mdb_unwind() kept on the stack; deeper trees use the arena.
+ * (Tests build with a smaller value to exercise the arena.) */
+#ifndef MDB_UNWIND_FAST
+#define MDB_UNWIND_FAST		8
+#endif
+/** Frames of the environment arena: an unwind and the nested REKEY unwind
+ * of a move, each at most #CURSOR_STACK + 2 frames */
+#define MDB_UNWIND_ARENA	(2 * (CURSOR_STACK + 2))
+
+/** Kinds of level results */
+enum {
+	MDB_LEVEL_NONE,		/**< the level is final, nothing to publish */
+	MDB_LEVEL_SPLIT,
+	MDB_LEVEL_REKEY,
+	MDB_LEVEL_UNDERFLOW
+};
+
+/** The result of a completed level, handed to #mdb_unwind() */
+typedef struct MDB_level_result {
+	unsigned int	 mlr_kind;	/**< MDB_LEVEL_* */
+	const MDB_split_result *mlr_split; /**< SPLIT: the completed local split */
+	unsigned int	 mlr_nflags;	/**< SPLIT: #NODE_ADD_FLAGS of the level */
+	MDB_val		*mlr_key;	/**< REKEY: new lower bound of the page */
+	int		 mlr_climb;	/**< REKEY: the page is the cursor's page;
+					 * the separator is at the lowest ancestor
+					 * with a non-zero index */
