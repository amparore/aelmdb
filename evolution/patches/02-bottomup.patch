+
+static void
+mdb_level_track(MDB_level *L)
+{
+	mdb_cursor_track(&L->lv_mn, &L->lv_track);
+	L->lv_tracking = 1;
+}
+
+static void
+mdb_level_untrack(MDB_level *L)
+{
+	mdb_cursor_untrack(&L->lv_track);
+	L->lv_tracking = 0;
+}
+
+static void
+mdb_level_init(MDB_level *L, unsigned int kind, MDB_cursor *mc)
+{
+	L->lv_kind = kind;
+	L->lv_mc = mc;
+	L->lv_owns = 0;
+	L->lv_did_split = 0;
+	L->lv_local_failed = 0;
+	L->lv_new_root = 0;
+	L->lv_dtop = 0;
+	L->lv_post = 0;
+	L->lv_merged = 0;
+	L->lv_up = 0;
+	L->lv_tracking = 0;
