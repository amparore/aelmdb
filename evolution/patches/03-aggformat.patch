+int ESECT
+mdb_set_hash_offset(MDB_txn *txn, MDB_dbi dbi, int hash_offset)
+{
+	MDB_db *db;
+	int rc;
+	if (!txn || !TXN_DBI_EXIST(txn, dbi, DB_USRVALID))
+		return EINVAL;
+	if (txn->mt_flags & MDB_TXN_BLOCKED)
+		return (txn->mt_flags & MDB_TXN_ERROR) && txn->mt_last_err ?
+			txn->mt_last_err : MDB_BAD_TXN;
+	if (txn->mt_flags & MDB_TXN_RDONLY)
+		return EACCES;
+	if (txn->mt_dbflags[dbi] & DB_STALE) {
+		rc = mdb_dbi_refresh_stale_snapshot(txn, dbi);
+		if (rc)
+			return rc;
+	}
+	db = &txn->mt_dbs[dbi];
+	if (!(DB_AGGFLAGS(db) & MDB_AGG_HASHSUM))
+		return MDB_INCOMPATIBLE;
+	if (db->md_root != P_INVALID || db->md_entries != 0 || db->md_depth != 0)
+		return MDB_INCOMPATIBLE;
+	if (hash_offset < INT16_MIN || hash_offset > INT16_MAX)
+		return EINVAL;
+	db->md_hash_offset = (int16_t)hash_offset;
+	txn->mt_dbflags[dbi] |= DB_DIRTY;
+	txn->mt_flags |= MDB_TXN_DIRTY;
+	return MDB_SUCCESS;
+}
