+static int
+mdb_dbi_check_agg_request(unsigned int flags)
+{
+	uint16_t reqschema = (uint16_t)(flags & MDB_AGG_SCHEMA_MASK);
+
+	if ((reqschema & MDB_AGG_HASHSOURCE_FROM_KEY) &&
+		!(reqschema & MDB_AGG_HASHSUM))
+		return MDB_INCOMPATIBLE;
+	if ((reqschema & MDB_AGG_HASHSOURCE_FROM_KEY) && (flags & MDB_DUPSORT))
+		return MDB_INCOMPATIBLE;
+	return MDB_SUCCESS;
+}
+
+static int
+mdb_dbi_check_format_flags(const MDB_db *db, unsigned int flags, int is_main, int is_new)
+{
+	unsigned int req;
+	uint16_t reqschema = (uint16_t)(flags & MDB_AGG_SCHEMA_MASK);
+	int rc = mdb_dbi_check_agg_request(flags);
+
+	if (rc)
+		return rc;
+	if ((reqschema & MDB_AGG_HASHSOURCE_FROM_KEY) &&
+		(db->md_flags & MDB_DUPSORT))
+		return MDB_INCOMPATIBLE;
+
+	if ((db->md_flags & MDB_AGG_HASHSOURCE_FROM_KEY) &&
+		(!(db->md_flags & MDB_AGG_HASHSUM) || (db->md_flags & MDB_DUPSORT)))
+		return MDB_INCOMPATIBLE;
+
+	if (!is_main) {
+		/* Aggregate flags define the physical branch-node schema, so an
+		 * explicitly requested aggregate schema must match exactly. Other
+		 * persistent LMDB flags retain the traditional subset check. */
+		if (!is_new && reqschema &&
+			reqschema != (db->md_flags & MDB_AGG_SCHEMA_MASK))
+			return MDB_INCOMPATIBLE;
+		req = flags & (PERSISTENT_FLAGS & ~MDB_AGG_SCHEMA_MASK);
+		if (!is_new && req && ((req & db->md_flags) != req))
+			return MDB_INCOMPATIBLE;
+	}
+	return MDB_SUCCESS;
+}
