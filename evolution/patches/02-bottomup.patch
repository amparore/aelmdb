+
+/** One frame of #mdb_unwind() */
+typedef struct MDB_level {
+	unsigned int	 lv_kind;
+	MDB_cursor	*lv_mc;		/**< cursor at this level */
+	/* SPLIT */
+	const MDB_split_result *lv_split;
