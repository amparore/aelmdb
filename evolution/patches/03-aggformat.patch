+/* Refresh the per-transaction snapshot of a named database record.
+ * DBI handles are environment-global, while MDB_db is transaction-local and
+ * starts as DB_STALE in a new transaction.  Format metadata beyond md_flags
+ * must never be read from that placeholder.
+ */
+static int
+mdb_dbi_refresh_stale_snapshot(MDB_txn *txn, MDB_dbi dbi)
+{
+	MDB_cursor mc2;
+	MDB_node *leaf;
+	MDB_val data;
+	MDB_db fresh;
+	uint16_t flags;
+	int exact = 0, rc;
+
+	if (!txn || dbi < CORE_DBS || dbi >= txn->mt_numdbs ||
+		!txn->mt_dbxs[dbi].md_name.mv_size)
+		return MDB_BAD_DBI;
+	if (TXN_DBI_CHANGED(txn, dbi))
+		return MDB_BAD_DBI;
+	if (!(txn->mt_dbflags[dbi] & DB_STALE))
+		return MDB_SUCCESS;
+
+	mdb_cursor_init(&mc2, txn, MAIN_DBI, NULL);
+	rc = mdb_page_search(&mc2, &txn->mt_dbxs[dbi].md_name, 0);
+	if (rc)
+		return rc;
+	leaf = mdb_node_search(&mc2, &txn->mt_dbxs[dbi].md_name, &exact);
+	if (!exact)
+		return MDB_BAD_DBI;
+	if ((leaf->mn_flags & (F_DUPDATA|F_SUBDATA)) != F_SUBDATA)
+		return MDB_INCOMPATIBLE;
+	rc = mdb_node_read(&mc2, leaf, &data);
+	if (rc)
+		return rc;
+	if (data.mv_size != sizeof(MDB_db))
+		return MDB_CORRUPTED;
+
+	/* MDB_db payloads in leaf nodes need not satisfy MDB_db alignment. */
+	memcpy(&fresh, data.mv_data, sizeof(fresh));
+	flags = fresh.md_flags;
+	if ((txn->mt_dbs[dbi].md_flags & PERSISTENT_FLAGS) !=
+		(flags & PERSISTENT_FLAGS))
+		return MDB_INCOMPATIBLE;
+
+	txn->mt_dbs[dbi] = fresh;
+	txn->mt_dbflags[dbi] &= ~DB_STALE;
+	return MDB_SUCCESS;
+}
