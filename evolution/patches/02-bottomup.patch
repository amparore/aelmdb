+	*rcp = MDB_SUCCESS;
+	if (L->lv_climb) {
+		/* if overwriting slot 0 of leaf, need to
+		 * update branch key if there is a parent page
+		 */
+		if (!(c->mc_top && !c->mc_ki[c->mc_top]))
+			return MDB_UP_STOP;
+		L->lv_dtop = 1;
+		c->mc_top--;
+		/* slot 0 is always an empty key, find real slot */
+		while (c->mc_top && !c->mc_ki[c->mc_top]) {
+			c->mc_top--;
+			L->lv_dtop++;
+		}
+		if (!c->mc_ki[c->mc_top])
+			return MDB_UP_STOP;
+	}
+	L->lv_owns = 1;
+	rc = mdb_branch_rekey_local(c, L->lv_key, &L->lv_own);
+	mdb_unwind_note(c, c->mc_top);		/* separator replaced here */
+	*rcp = rc;
+	if (!rc && L->lv_own.msr_right) {
+		mdb_level_init(P, MDB_LEVEL_SPLIT, c);
+		P->lv_split = &L->lv_own;
+		P->lv_nflags = MDB_SPLIT_REPLACE;
+		return MDB_UP_PUSH;
+	}
+	return MDB_UP_STOP;
+}
+
+static void
+mdb_level_rekey_down(MDB_level *L)
+{
+	if (L->lv_owns)
+		mdb_split_result_destroy(&L->lv_own);
+	L->lv_mc->mc_top += L->lv_dtop;
+}
+
+/** UNDERFLOW, up: rebalance the page of this level.  A merge removes a link
+ * from the parent, which is the next level. */
+static int
+mdb_level_underflow_up(MDB_level *L, MDB_level *P, int *rcp)
+{
+	MDB_cursor *c = L->lv_mc;
+	MDB_node	*node;
+	unsigned int ptop, minkeys, thresh;
+	int rc;
+
+	if (IS_BRANCH(c->mc_pg[c->mc_top])) {
+		minkeys = 2;
+		thresh = 1;
+	} else {
+		minkeys = 1;
+		thresh = FILL_THRESHOLD;
+	}
+	DPRINTF(("rebalancing %s page %"Yu" (has %u keys, %.1f%% full)",
+	    IS_LEAF(c->mc_pg[c->mc_top]) ? "leaf" : "branch",
+	    mdb_dbg_pgno(c->mc_pg[c->mc_top]), NUMKEYS(c->mc_pg[c->mc_top]),
+		(float)PAGEFILL(c->mc_txn->mt_env, c->mc_pg[c->mc_top]) / 10));
+
+	if (PAGEFILL(c->mc_txn->mt_env, c->mc_pg[c->mc_top]) >= thresh &&
+		NUMKEYS(c->mc_pg[c->mc_top]) >= minkeys) {
+		DPRINTF(("no need to rebalance page %"Yu", above fill threshold",
+		    mdb_dbg_pgno(c->mc_pg[c->mc_top])));
+		mdb_unwind_note(c, c->mc_top);	/* this page changed, not above */
+		*rcp = MDB_SUCCESS;
+		return MDB_UP_STOP;
+	}
+
+	if (c->mc_snum < 2) {
+		*rcp = mdb_rebalance_root(c);
+		mdb_unwind_note(c, 0);
+		return MDB_UP_STOP;
+	}
+
+	/* The parent (branch page) must have at least 2 pointers,
+	 * otherwise the tree is invalid.
+	 */
+	ptop = c->mc_top-1;
+	mdb_cassert(c, NUMKEYS(c->mc_pg[ptop]) > 1);
+
+	/* Leaf page fill factor is below the threshold.
+	 * Try to move keys from left or right neighbor, or
+	 * merge with a neighbor page.
+	 */
+
+	/* Find neighbors.
+	 */
+	mdb_cursor_copy(c, &L->lv_mn);
+	L->lv_mn.mc_xcursor = NULL;
+
+	L->lv_oldki = c->mc_ki[c->mc_top];
+	if (c->mc_ki[ptop] == 0) {
+		/* We're the leftmost leaf in our parent.
+		 */
+		DPUTS("reading right neighbor");
+		L->lv_mn.mc_ki[ptop]++;
+		node = NODEPTR(c->mc_pg[ptop], L->lv_mn.mc_ki[ptop]);
+		rc = mdb_page_get(c, NODEPGNO(node), &L->lv_mn.mc_pg[L->lv_mn.mc_top], NULL);
+		if (rc) {
+			*rcp = rc;
+			return MDB_UP_STOP;
+		}
+		L->lv_mn.mc_ki[L->lv_mn.mc_top] = 0;
+		c->mc_ki[c->mc_top] = NUMKEYS(c->mc_pg[c->mc_top]);
+		L->lv_fromleft = 0;
+	} else {
+		/* There is at least one neighbor to the left.
+		 */
+		DPUTS("reading left neighbor");
+		L->lv_mn.mc_ki[ptop]--;
+		node = NODEPTR(c->mc_pg[ptop], L->lv_mn.mc_ki[ptop]);
+		rc = mdb_page_get(c, NODEPGNO(node), &L->lv_mn.mc_pg[L->lv_mn.mc_top], NULL);
+		if (rc) {
+			*rcp = rc;
+			return MDB_UP_STOP;
+		}
+		L->lv_mn.mc_ki[L->lv_mn.mc_top] = NUMKEYS(L->lv_mn.mc_pg[L->lv_mn.mc_top]) - 1;
+		c->mc_ki[c->mc_top] = 0;
+		L->lv_fromleft = 1;
+	}
+	L->lv_post = 1;
+
+	DPRINTF(("found neighbor page %"Yu" (%u keys, %.1f%% full)",
+	    L->lv_mn.mc_pg[L->lv_mn.mc_top]->mp_pgno, NUMKEYS(L->lv_mn.mc_pg[L->lv_mn.mc_top]),
+		(float)PAGEFILL(c->mc_txn->mt_env, L->lv_mn.mc_pg[L->lv_mn.mc_top]) / 10));
+
+	/* If the neighbor page is above threshold and has enough keys,
+	 * move one key from it. Otherwise we should try to merge them.
+	 * (A branch page must never have less than 2 keys.)
+	 */
+	if (PAGEFILL(c->mc_txn->mt_env, L->lv_mn.mc_pg[L->lv_mn.mc_top]) >= thresh &&
+		NUMKEYS(L->lv_mn.mc_pg[L->lv_mn.mc_top]) > minkeys) {
+		MDB_move_result move;
+
+		rc = mdb_node_move_local(&L->lv_mn, c, L->lv_fromleft, &move);
+		mdb_unwind_note(c, ptop);	/* separators in the parent */
+		if (!rc)
+			rc = mdb_rebalance_apply_move(&L->lv_mn, c, &move);
+		if (L->lv_fromleft) {
+			/* if we inserted on left, bump position up */
+			L->lv_oldki++;
+		}
+		*rcp = rc;
+		return MDB_UP_STOP;
+	} else {
+		MDB_cursor *csrc, *cdst;
+		L->lv_merged = 1;
+		if (!L->lv_fromleft) {
+			csrc = &L->lv_mn;
+			cdst = c;
+		} else {
+			L->lv_oldki += NUMKEYS(L->lv_mn.mc_pg[L->lv_mn.mc_top]);
+			L->lv_mn.mc_ki[L->lv_mn.mc_top] += c->mc_ki[L->lv_mn.mc_top] + 1;
+			/* We want the rebalance to find mn when doing fixups */
+			mdb_level_track(L);
+			csrc = c;
+			cdst = &L->lv_mn;
+		}
+		rc = mdb_page_merge_local(csrc, cdst, &L->lv_merge);
+		if (!rc)
+			rc = mdb_rebalance_apply_merge(csrc, cdst, &L->lv_merge);
+		*rcp = rc;
+		if (rc)
+			return MDB_UP_STOP;
+		/* the parent lost a link: continue there */
+		L->lv_up = 1;
+		L->lv_cdst = cdst;
+		L->lv_rsnum = cdst->mc_snum;
+		L->lv_depth = cdst->mc_db->md_depth;
+		mdb_cursor_pop(cdst);
+		mdb_level_init(P, MDB_LEVEL_UNDERFLOW, cdst);
+		return MDB_UP_PUSH;
+	}
+}
+
+static void
+mdb_level_underflow_down(MDB_level *L)
+{
+	MDB_cursor *c = L->lv_mc;
+
+	if (L->lv_up) {
+		MDB_cursor *cdst = L->lv_cdst;
+		unsigned int snum = L->lv_rsnum;
+		/* Did the tree height change? */
+		if (L->lv_depth != cdst->mc_db->md_depth)
+			snum += cdst->mc_db->md_depth - L->lv_depth;
+		cdst->mc_snum = snum;
+		cdst->mc_top = snum-1;
+	}
+	if (L->lv_tracking) {
+		mdb_level_untrack(L);
+		mdb_cursor_copy(&L->lv_mn, c);
+	}
+	if (L->lv_merged)
+		c->mc_flags &= ~C_EOF;
+	if (L->lv_post)
+		c->mc_ki[c->mc_top] = L->lv_oldki;
+}
+
+/** Propagate a completed level up the tree (see @ref unwind).
+ * @param[in] mc cursor at the level that produced @p res
+ * @param[in] res what the level produced
+ * @return 0 on success, non-zero on failure.
+ */
+static int
+mdb_unwind(MDB_cursor *mc, const MDB_level_result *res)
+{
+	MDB_level fast[MDB_UNWIND_FAST];
+	MDB_level *lv, *L;
+	MDB_env *env = mc->mc_txn->mt_env;
+	unsigned int frames, arena = 0;
+	int n = 0, k, up, rc = MDB_SUCCESS;
+
+	if (res->mlr_kind == MDB_LEVEL_NONE)
+		return MDB_SUCCESS;
+	/* A level pushes at most one frame and the levels end at the root:
+	 * md_depth frames, plus the spare frame an up step may fill. */
+	frames = mc->mc_db->md_depth + 2;
+	if (frames <= MDB_UNWIND_FAST) {
+		lv = fast;
+	} else {
+		mdb_cassert(mc, env->me_unwind &&
+			env->me_unwind_used + frames <= MDB_UNWIND_ARENA);
+		lv = env->me_unwind + env->me_unwind_used;
+		env->me_unwind_used += frames;
+		arena = frames;
+	}
+	mdb_level_init(&lv[0], res->mlr_kind, mc);
+	lv[0].lv_split = res->mlr_split;
+	lv[0].lv_nflags = res->mlr_nflags;
+	lv[0].lv_key = res->mlr_key;
+	lv[0].lv_climb = res->mlr_climb;
+
+	/* up: one level per iteration */
+	for (;;) {
+		L = &lv[n];
+		mdb_cassert(mc, (unsigned int)n + 1 < frames);
+		switch (L->lv_kind) {
+		case MDB_LEVEL_SPLIT:
+			up = mdb_level_split_up(L, &lv[n+1], &rc);
+			break;
+		case MDB_LEVEL_REKEY:
+			up = mdb_level_rekey_up(L, &lv[n+1], &rc);
+			break;
+		default:
+			up = mdb_level_underflow_up(L, &lv[n+1], &rc);
+			break;
+		}
+		if (up == MDB_UP_STOP)
+			break;
+		n++;
+		if (up == MDB_UP_PUSH_STOP)
+			break;
+	}
+
+	/* down: complete the levels, the highest first */
+	for (k = n; k >= 0; k--) {
+		L = &lv[k];
+		switch (L->lv_kind) {
+		case MDB_LEVEL_SPLIT:
+			mdb_level_split_down(L, rc);
+			break;
+		case MDB_LEVEL_REKEY:
+			mdb_level_rekey_down(L);
+			break;
+		default:
+			mdb_level_underflow_down(L);
+			break;
+		}
+	}
+	env->me_unwind_used -= arena;
+	return rc;
+}
+
+/** Publish an already-completed local split to the ancestor path.
+ * Shared by insertion splits and separator replacement splits.
+ */
+static int
+mdb_split_publish(MDB_cursor *mc, const MDB_split_result *split,
+	unsigned int nflags)
+{
+	MDB_level_result res;
+
+	res.mlr_kind = MDB_LEVEL_SPLIT;
+	res.mlr_split = split;
+	res.mlr_nflags = nflags;
+	res.mlr_key = NULL;
+	res.mlr_climb = 0;
+	return mdb_unwind(mc, &res);
+}
+
+/** Split a page and insert a new node using bottom-up publication.
+ * Set #MDB_TXN_ERROR on failure.
+ * @param[in,out] mc Cursor pointing to the page and desired insertion index.
+ * The cursor will be updated to point to the actual page and index where
+ * the node got inserted after the split.
+ * @param[in] newkey The key for the newly inserted node.
+ * @param[in] newdata The data for the newly inserted node.
+ * @param[in] newpgno The page number, if the new node is a branch node.
+ * @param[in] nflags The #NODE_ADD_FLAGS for the new node.
+ * @return 0 on success, non-zero on failure.
+ */
+static int
+mdb_page_split(MDB_cursor *mc, MDB_val *newkey, MDB_val *newdata,
+	pgno_t newpgno, unsigned int nflags)
+{
+	MDB_split_result split;
+	int rc;
+
+	rc = mdb_page_split_local(mc, newkey, newdata, newpgno, nflags, &split);
+	if (rc) {
 		mdb_txn_mark_error(mc->mc_txn, rc);
+		goto done;
+	}
+
+	/* The local page pair is final here. Ancestor publication starts only
+	 * after crossing this explicit bottom-up boundary.
+	 */
+	rc = mdb_split_publish(mc, &split, nflags);
+
+ done:
+	mdb_split_result_destroy(&split);
 	return rc;
 }
 
+/** Rebalance the tree after a delete operation (UNDERFLOW at the cursor's
+ * level, see @ref unwind).
+ * @param[in] mc Cursor pointing to the page where rebalancing
+ * should begin.
+ * @return 0 on success, non-zero on failure.
+ */
+static int
+mdb_rebalance(MDB_cursor *mc)
+{
+	MDB_level_result res;
+
+	res.mlr_kind = MDB_LEVEL_UNDERFLOW;
+	res.mlr_split = NULL;
+	res.mlr_nflags = 0;
+	res.mlr_key = NULL;
+	res.mlr_climb = 0;
+	return mdb_unwind(mc, &res);
+}
+
+/** Replace the separator of the cursor's page with @p key (REKEY).
+ * @param[in] climb the cursor is at the page itself: the separator is at
+ *	the lowest ancestor with a non-zero index (none: nothing to do);
+ *	otherwise the cursor is already at the parent, on the separator
+ */
+static int
+mdb_rekey(MDB_cursor *mc, MDB_val *key, int climb)
+{
+	MDB_level_result res;
+
+	res.mlr_kind = MDB_LEVEL_REKEY;
+	res.mlr_split = NULL;
+	res.mlr_nflags = 0;
+	res.mlr_key = key;
+	res.mlr_climb = climb;
+	return mdb_unwind(mc, &res);
+}
+
+/** @} */
+
 int
 mdb_put(MDB_txn *txn, MDB_dbi dbi,
     MDB_val *key, MDB_val *data, unsigned int flags)
